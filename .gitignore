# ==========================================
# Root .gitignore for Pocket Monorepo
# ==========================================

# OS Files
.DS_Store
Thumbs.db
*.swp
*.bak
*~

# IDE & Editor
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ==========================================
# Backend (server/ - Bun / Node / Prisma)
# ==========================================
**/node_modules/
**/.pnp/
**/.pnp.js
**/dist/
**/out/
**/coverage/
*.lcov
.nyc_output/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.cache/

# Environment Variables (Secrets - NEVER commit)
**/.env
**/.env.*
!**/.env.example

# ==========================================
# Frontend (app/ - Flutter / Dart)
# ==========================================
**/doc/api/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/app.*.symbols
**/app.*.map.json
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/.widget_preview/
**/ios/Flutter/.last_build_id

